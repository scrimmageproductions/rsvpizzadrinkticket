# Worker SECRETS (declared with bindings.secret() in cloudflare.config.ts).
#   Local:       copy to .dev.vars (gitignored) — read by `npm run dev` / `npm start`.
#   Production:  npx cf workers secrets put <NAME>     (one per line below)
# Workers mirror them into process.env, which is how the server code reads them.

# Privy server secret (pairs with NEXT_PUBLIC_PRIVY_APP_ID)
PRIVY_APP_SECRET=

# Pimlico (ERC-4337 bundler + verifying paymaster). Server-only: the browser goes through /api/aa.
# In the Pimlico dashboard, create a sponsorship policy limited to NEXT_PUBLIC_TICKETS_ADDRESS.
PIMLICO_API_KEY=
PIMLICO_SPONSORSHIP_POLICY_ID=                  # optional sp_... id

# Claim voucher signer (holds SIGNER_ROLE on RsvpTickets). Dedicated hot key, no funds.
CLAIM_SIGNER_PRIVATE_KEY=0x...

# Host override wallet (ADMIN_ROLE: Host Vouch, Wingman Transfer, Make It Right grants).
# Grant ADMIN_ROLE to the smart-account address it derives:  npm run admin:address
ADMIN_PRIVATE_KEY=0x...

# Signing secret for invite links + kiosk presence passes. ≥ 32 random chars: openssl rand -hex 32
APP_SECRET=

# Comma-separated staff emails allowed into /host/* (matched against the Privy login).
HOST_EMAILS=host@rsv.pizza,door@rsv.pizza
