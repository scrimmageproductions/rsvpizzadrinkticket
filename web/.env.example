# Public, build-time settings (inlined into the client bundle by `vite build`).
# Copy to .env. Server SECRETS do not go here — see .dev.vars.example.
# The database is Cloudflare D1, bound as `DB` in cloudflare.config.ts (no URL or key needed).

# ─── Demo Mode ───────────────────────────────────────────────────────────
# true = whole journey runs in the browser on mock data (no Privy/D1/Pimlico/chain).
# Also switches on automatically when NEXT_PUBLIC_PRIVY_APP_ID is empty.
NEXT_PUBLIC_DEMO_MODE=false
NEXT_PUBLIC_DEFAULT_EVENT_ID=pizza-night-nyc   # where /admin sends staff
NEXT_PUBLIC_APP_URL=https://rsv.pizza          # public origin used in kiosk QR codes + invite emails

# ─── Chain ───────────────────────────────────────────────────────────────
NEXT_PUBLIC_CHAIN=baseSepolia                   # or "base" for Base mainnet (chain 8453)
NEXT_PUBLIC_RPC_URL=                            # optional; public Base RPC is rate-limited — use Alchemy/CDP in prod
NEXT_PUBLIC_TICKETS_ADDRESS=0x...               # RsvpTickets deployment (contracts/script/Deploy.s.sol)

# ─── Privy (email / SMS / Google login → embedded non-custodial wallet) ───
NEXT_PUBLIC_PRIVY_APP_ID=
