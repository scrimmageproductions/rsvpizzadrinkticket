# ─── Chain ───────────────────────────────────────────────────────────────
NEXT_PUBLIC_CHAIN=avalancheFuji                 # or "avalanche" for C-Chain mainnet
NEXT_PUBLIC_RPC_URL=                            # optional, defaults to public Avalanche RPC
NEXT_PUBLIC_TICKETS_ADDRESS=0x...               # RsvpTickets deployment (contracts/script/Deploy.s.sol)

# ─── Privy (email / SMS / Google login → embedded non-custodial wallet) ───
NEXT_PUBLIC_PRIVY_APP_ID=
PRIVY_APP_SECRET=

# ─── Pimlico (ERC-4337 bundler + verifying paymaster) ────────────────────
# Server-only. The browser talks to /api/aa which proxies to Pimlico, so the key never ships.
# In the Pimlico dashboard create a sponsorship policy limited to NEXT_PUBLIC_TICKETS_ADDRESS.
PIMLICO_API_KEY=
PIMLICO_SPONSORSHIP_POLICY_ID=                  # optional sp_... id

# ─── Supabase (RSVP status, Event PIN, Theme Color of the Night) ─────────
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ─── Claim voucher signer (holds SIGNER_ROLE on RsvpTickets) ─────────────
# Use a dedicated hot key with no funds. Rotate with grantRole/revokeRole.
CLAIM_SIGNER_PRIVATE_KEY=0x...

# ─── Host / door-staff access ────────────────────────────────────────────
# Comma-separated emails allowed into /host/* (matched against the Privy login).
HOST_EMAILS=host@rsv.pizza,door@rsv.pizza
