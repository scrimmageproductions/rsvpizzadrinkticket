    "@vinext/cloudflare": "^1.3.3",
    "framer-motion": "^14.9.0",
    "next": "16.4.4",
    "permissionless": "^0.2.57",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-server-dom-webpack": "^19.3.1",
    "viem": "^2.56.5",
    "vinext": "^1.4.4",
    "wagmi": "^3.7.9",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^2.0.0-beta.v.13",
    "@tailwindcss/postcss": "^4.3.5",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitejs/plugin-rsc": "^0.5.39",
    "cf": "^1.0.0-beta.28",
    "eslint": "^9",
    "eslint-config-next": "16.4.4",
    "miniflare": "^5.20261109.0-beta",
    "server-only": "^0.0.1",
    "tailwindcss": "^4",
