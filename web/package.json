  "scripts": {
    "dev": "vite dev --port 3000",
    "build": "vite build",
    "start": "vite preview --port 3000",
    "lint": "eslint",
    "typecheck": "next typegen && cf workers types && tsc --noEmit",
    "abi": "node scripts/gen-abi.mjs",
    "verify:voucher": "NODE_OPTIONS=--conditions=react-server tsx scripts/verify-voucher.ts",
    "admin:address": "tsx scripts/admin-address.ts",
    "demo": "NEXT_PUBLIC_DEMO_MODE=true vite dev --port 3000",
    "export:code": "node scripts/export-codebase.mjs",
    "deploy": "vinext-cloudflare deploy",
    "test:db": "NODE_OPTIONS='--conditions=react-server --import ./scripts/test/hooks.mjs' tsx scripts/test/d1-ledger.test.ts",
    "db:migrate:local": "cf d1 migrations apply 4c79d4e7-b9b3-4438-97a1-70ea79e21a64 --local --persist-to .cloudflare/state",
    "db:seed:local": "tsx scripts/db-seed-local.ts",
    "db:migrate": "cf d1 migrations apply 4c79d4e7-b9b3-4438-97a1-70ea79e21a64"
  },
